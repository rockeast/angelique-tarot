# ========================================
# Angel Tarot — 環境変数テンプレート
# ========================================
# このファイルをコピーして .env にリネームし、実際の値を入力してください
# cp .env.example .env

# Groq API キー (https://console.groq.com でAPIキーを発行)
GROQ_API_KEY=your_groq_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe 決済キー (https://dashboard.stripe.com/apikeys)
# 明示的に true にした場合のみ新規決済を受け付けます。停止中は false のままにします。
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_MONTHLY=price_xxxxx
STRIPE_PRICE_YEARLY=price_xxxxx

# カンマ区切り。例: https://example.com,https://www.example.com
# 未指定の場合、ブラウザからのクロスオリジンAPIアクセスは許可しません。
ALLOWED_ORIGINS=

# Google Analytics 4（管理画面のウェブデータストリームに表示される G- から始まるID）
# 空欄の間は解析タグを読み込まず、データも送信しません。
GA4_MEASUREMENT_ID=
# ローカル確認をGA4へ送る場合だけ true（通常はfalseのまま）
GA4_ALLOW_LOCALHOST=false

# サーバーポート
PORT=3000
NODE_ENV=production
